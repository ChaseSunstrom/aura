<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis — standalone Android app (ai.jarvis.app). No Home Assistant code, no
  Google Play Services, no Firebase.

  This file is DELIBERATELY COMPLETE: it declares every permission and every
  component the assist, automation and trigger modules need, so no other module
  has to edit it. Components under ai.jarvis.app.automation.** are declared here
  but IMPLEMENTED by the automation module.

  About the permission list. A permission in this manifest is only a *capability
  declaration*. Nothing here grants anything: every dangerous permission is
  requested at runtime, at the moment it is first needed, and every action that
  uses one is gated by the device-local policy table:

    Tier 1 AUTO    — read-only or trivially reversible; runs without asking.
    Tier 2 NOTIFY  — recoverable state change; ask once, then remember per action.
    Tier 3 CONFIRM — full-screen consent EVERY time, showing the verbatim action,
                     parameters and reason. Never auto-approved, never remembered.

  The tier is decided by a LOCAL table on the device. The `tier` field in an
  incoming server command may only RAISE it (max(local, incoming)), never lower
  it. See ai.jarvis.app.ui.ApprovalBridge and the automation module's policy
  store. Each permission below is tagged with the highest tier it serves.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== transport ===================== -->
    <!-- Tier 1. Talking to jarvis-core over LAN/WireGuard. Cleartext is
         restricted to the documented hosts in @xml/network_security_config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ===================== voice ===================== -->
    <!-- Tier 1 (the user initiates every capture: gesture, tap or wake word).
         Audio is streamed to the server's STT and never written to disk. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Tier 1. Volume / audio routing for TTS playback and barge-in. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ===================== notifications ===================== -->
    <!-- Tier 1 to post a local notification; ALSO the delivery path for Tier-3
         consent prompts when the app is in the background — denying this makes
         approvals time out, which fails closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Tier 3 support: raises a pending consent prompt over the lock screen.
         On Android 14+ this is granted only to calling/alarm apps, so we treat
         a downgrade to a heads-up notification as the normal case. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Tier 3 support: lets the consent prompt start from the background at
         all. Special access — the user grants it in Settings > Apps > Special
         app access > Display over other apps. Without it, a Tier-3 request
         arriving while the app is backgrounded can only be answered by tapping
         its notification. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===================== foreground services ===================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Wake-word / open-mic listening in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Short-lived sync work kicked off by a command. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The persistent command channel to jarvis-core. It is a long-lived
         WebSocket, which none of the narrower FGS types describe. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Special access, user-granted in Settings; keeps the command channel
         alive on aggressive OEM/Graphene battery policies. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ===================== device feedback ===================== -->
    <!-- Tier 1. Haptic tick when the orb appears. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tier 1. Torch, via CameraManager.setTorchMode. FLASHLIGHT is a legacy
         normal permission; the torch itself needs no dangerous permission. -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- Tier 2. Ringer mode / Do Not Disturb changes. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Tier 2. Special access (Settings.System.canWrite) — screen brightness,
         auto-rotate and friends. -->
    <!-- set_wallpaper (M61): a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===================== location ===================== -->
    <!-- Tier 1 for a coarse fix ("where am I", "is it far"). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Tier 2. Precise fix — navigation, geofenced triggers. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Tier 2. Location-based triggers while the app is not in use. Requested
         separately, after foreground location, exactly as the platform demands. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ===================== people ===================== -->
    <!-- Anything that contacts another human is CONFIRM (tier 3), except emergency_alert:
         its cancellable full-screen countdown, showing the names and the words, is the consent
         (T-1015). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Tier 1 (resolve a name to a number for the consent prompt) — but the
         send/call it feeds is Tier 3. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Tier 3, every time (M61: the last Tasker rows). Reading the inbox and
         the call log is other people's words and other people's numbers, and
         every result is marked untrusted; hanging up is done to a person. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- ===================== calendar ===================== -->
    <!-- Tier 1 to read. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Tier 2 to create/modify an event. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- ===================== alarms ===================== -->
    <!-- Tier 2. Setting an alarm/timer, and scheduling automation triggers. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- ===================== body & nearby ===================== -->
    <!-- Tier 1. Step count, via Sensor.TYPE_STEP_COUNTER. Dangerous since
         Android 10, which is this app's floor, so it is always a runtime
         request. `get_sensors` checked for it and it was never declared, so the
         check could only ever fail. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- ===================== camera & media ===================== -->
    <!-- Tier 3. "What am I looking at", and take_photo (M61): an explicit,
         approved capture, never a quiet one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Normal permission. nfc_read / nfc_write (M61) arm reader mode on a
         one-frame Activity; the tag has to be held to the phone by a person. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- Tier 2. Reading media the user points Jarvis at. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ===================== bluetooth ===================== -->
    <!-- Tier 1. Car/headset connection state drives the wake-word gate. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ===================== packages ===================== -->
    <!--
      "Open <app>" by name needs the full launcher list, which is what
      QUERY_ALL_PACKAGES is for. Everything else Jarvis resolves is an
      INTENT, and an intent is visible through a <queries> entry without
      any permission at all — see the <queries> block below.

      That distinction matters on GrapheneOS. QUERY_ALL_PACKAGES is one of
      the permissions a hardened setup is most likely to have stripped, and a
      feature that silently stops working is worse than one that was never
      built. So the intents Jarvis needs are declared explicitly and keep
      working when this permission is gone; only "list every installed app"
      degrades, and it degrades to a clear "no matching app" rather than a
      crash.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+: lets a self-update skip the "install?" prompt when the platform allows
         (it installed the current version, same signing key). ADR-0050; a normal permission. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Package visibility for the specific things Jarvis hands off to. None of
      these needs QUERY_ALL_PACKAGES; declaring them means the handoff still
      resolves on a device where that permission was denied.
    -->
    <queries>
        <!-- Anything with a launcher entry: "open Maps". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- "Play Daft Punk": the music app that answers play-from-search (phone_media). -->
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <!-- Browser, for opening a link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Dialler and SMS. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Navigation. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Sharing text, e.g. a task result. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The QR scanner the settings screen offers to hand the token to. -->
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <!-- Shizuku, when the user has installed it for shell actions. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- ===================== privileged shell ===================== -->
    <!-- Tier 3, every time. Shizuku is optional and not bundled; the automation
         module adds the client library if shell actions are wanted. Declaring
         the permission string here costs nothing when Shizuku is absent. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Hardware is optional so the app installs on any device. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!--
      The car link (ADR-0047, from Headway). Bluetooth for the wireless
      handshake only, neverForLocation so a scan is not a location request;
      Wi-Fi and network change to join the car's access point with
      requestNetwork; the two foreground types the session runs under; and the
      companion exemption that lets the car's Bluetooth start the session from
      the background (a CompanionDeviceManager association, made in the car
      setup). All normal or runtime, none privileged.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The location type, which a hosted navigation app's marker needs (Headway B-026). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <!--
      The car-app template host (Headway ADR 0007): Jarvis draws other apps'
      car interfaces. Both names are global to the device (one definer per
      permission, one owner per authority), so Jarvis does not install beside
      Headway or anything else that holds them; CarLinkService says which
      package does (Headway ADR 0009, docs/car/adr/H-0009).
    -->
    <permission
        android:name="android.car.permission.TEMPLATE_RENDERER"
        android:protectionLevel="signature"
        tools:ignore="ReservedSystemPermission" />
    <uses-permission android:name="android.car.permission.TEMPLATE_RENDERER" />
    <!--
      Jarvis's own car app is a navigation app (T-0613): the host refuses a
      NavigationTemplate without the first and never hands over the map
      surface without the second. Both are normal permissions, granted at install.
    -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:name=".JarvisApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_aura"
        android:roundIcon="@mipmap/ic_aura"
        android:theme="@style/Theme.Jarvis"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          The Jarvis home: orb, tap-to-talk, live transcript, and the nav to
          Management / Automations / Settings.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          The launcher entry, one per persona (the owner, 2026-09-25: "depending on
          which persona is selected in the settings, can we change the app icon/name
          of the app to match the persona?"). Exactly one is enabled at a time;
          PersonaIcon.kt switches them when the primary persona changes. On aliases,
          not MainActivity itself, so the activity is never the thing disabled.
          AURA, the default theme pack (T-0869), is the one enabled at install;
          android-app/tools/aura_theme_test.py pins that and one alias per persona.
        -->
        <activity-alias
            android:name=".LauncherAura"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_aura"
            android:roundIcon="@mipmap/ic_aura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherJarvis"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Jarvis"
            android:icon="@mipmap/ic_jarvis"
            android:roundIcon="@mipmap/ic_jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Siri-like activation surface. Transparent, never in recents, works on
          the lock screen. exported=true is required for the system to deliver
          ACTION_ASSIST (assist gesture / assistant role / adb am start).
        -->
        <activity
            android:name=".JarvisAssistActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisTransparent"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity="ai.jarvis.app.assist"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <!--
              NO android:noHistory. It was here, and it is the reason the
              "Hey Jarvis" surface vanished the moment Jarvis asked anything.

              `noHistory` finishes an activity as soon as it stops being
              visible — and it cannot tell WHY. The consent prompt, a question,
              and the runtime-permission trampoline all appear over this
              activity by design, in tasks of their own, and every one of them
              destroyed the conversation underneath on the way up. Answering
              the prompt then returned to nothing, so a turn that needed one
              approval could not be finished at all.

              PermissionRequestActivity carries the same warning for the same
              reason, in its own words: "a `noHistory` host is finished the
              moment it loses the foreground and the result lands on a dead
              window".

              What noHistory was genuinely providing — not lingering invisibly
              once the user has moved on — is now done deliberately in
              onStop(), which finishes UNLESS one of our own prompts is up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Share → Jarvis from any app: the text or link becomes the prompt (SharePrompt). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          One frame of Activity, so that starting the microphone service is
          legal. Android refuses a background start of a foreground service
          typed `microphone`, which is why "always on" stopped after every
          reboot; a start from a resumed Activity is always permitted. Every
          one-tap repair — the notification, the quick-settings tile — points
          here. Not exported: only this app's own PendingIntents reach it.
        -->
        <activity
            android:name=".ListenTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisInvisible"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.jarvis.app.listen"
            android:noHistory="true" />

        <!--
          The other trampoline: one frame of Activity so that ASKING for a
          dangerous permission is possible at all. `requestPermissions` is a
          method on Activity and every command arrives in a Service, which is
          why SMS, calls, contacts, calendar and location were declared here and
          never once requested. See ai.jarvis.app.ui.PermissionBridge.

          Deliberately NOT `noHistory`: the system's permission dialog is a
          separate activity, so a noHistory host would be finished the moment it
          lost the foreground and the result would land on a dead window. And
          NOT `showWhenLocked`: a permission dialog on a locked phone is
          answered by whoever is holding it.
        -->
        <activity
            android:name=".PermissionRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOneFrame"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.jarvis.app.permission"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Two more one-frame hosts, for the Tasker rows that end in an Activity
          rather than a system service (M61, ForegroundResultBridge). scan_code
          hands off to the scanner app and waits for its result; nfc_read and
          nfc_write arm NFC reader mode, which only a resumed Activity can.
          Same rules as the permission trampoline: not `noHistory` (the scanner
          is a separate activity and the result would land on a dead window),
          `configChanges` so a rotation is not a second request, not exported.
        -->
        <activity
            android:name=".ScanCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOneFrame"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.jarvis.app.scan"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".NfcTagActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisOneFrame"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.jarvis.app.nfc"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Server URL, token, pipeline, device name, wake-word gating. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/activity_settings"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          The GrapheneOS checklist: every permission and special access Jarvis
          can use, whether it has it, what breaks without it, and a button that
          opens the exact settings page. This is the screen that answers "it
          installed but nothing happens".
        -->
        <activity
            android:name=".ui.SystemCheckActivity"
            android:exported="false"
            android:label="@string/activity_system_check"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Crash logs, readable on the device. crash/JarvisCrashHandler writes
          them; this shows them. No cable, no laptop, no logcat.
        -->
        <!--
          Enrolling a voice. Not exported: the microphone opens here and the
          bearer token goes out of it, and neither belongs to another app.
        -->
        <activity
            android:name=".VoiceIdentityActivity"
            android:exported="false"
            android:label="@string/activity_voice_identity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Teaching the wake word the owner's takes (T-0714). Not exported: it opens the mic. -->
        <activity
            android:name=".WakeEnrolActivity"
            android:exported="false"
            android:label="@string/activity_wake_enrol"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".ui.CrashLogActivity"
            android:exported="false"
            android:label="@string/activity_crash_logs"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          The old name of Jarvis's settings, folded into SettingsActivity (T-0689): kept so a
          shortcut or a notification that names it still opens the one settings screen.
        -->
        <activity-alias
            android:name=".JarvisSettingsActivity"
            android:targetActivity=".SettingsActivity"
            android:exported="false"
            android:label="AURA settings" />

        <!--
          THE TIER-3 CONSENT SCREEN. Full-screen over anything, including the
          lock screen. launchMode is standard on purpose: two concurrent
          requests stack, and each instance answers its own request id rather
          than one silently replacing the other. exported=false — only this app
          may raise a consent prompt.
        -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisApproval"
            android:label="@string/activity_approval"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="standard"
            android:taskAffinity="ai.jarvis.app.approval"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          THE EMERGENCY COUNTDOWN (T-0947) — the owner's cancel for emergency_alert.
          Declared like ApprovalActivity: exported=false so no other app can raise
          or fake it, over the lock screen, off the recents list. Its own
          taskAffinity so it never lands in the main task. configChanges so a
          rotation does not recreate it mid-count. It asks for no permission.
        -->
        <activity
            android:name=".ui.EmergencyCountdownActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisApproval"
            android:label="@string/activity_emergency"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity="ai.jarvis.app.emergency"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          THE CROSS-DEVICE QUESTION SCREEN — jarvis-core asking YOU something
          and waiting for the answer. A close relative of ApprovalActivity, and
          the differences are deliberate:

          exported=false — only this app may raise a question, so no other app
          can forge one, and the message_id extras cannot be supplied from
          outside. launchMode standard, like the consent screen: two questions
          stack and each answers its own message_id rather than one silently
          replacing the other and leaving the server waiting on a reply that
          will never come. Its own taskAffinity so it never lands in the main
          Jarvis task. configChanges covers rotation: a recreated activity
          reports `dismissed` in onDestroy, which would escalate a question the
          user is in the middle of reading. No android:noHistory — the question
          must survive the user glancing at another app.
        -->
        <activity
            android:name=".companion.CompanionAskActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisApproval"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="standard"
            android:taskAffinity="ai.jarvis.app.companion"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          VoiceInteractionService so the app can hold the device assistant role
          (Settings > Apps > Default apps > Digital assistant app, or the Secure
          Settings written by adb — see README).
        -->
        <service
            android:name=".assist.JarvisVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="@string/voice_interaction_label">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/jarvis_voice_interaction_service" />
        </service>

        <service
            android:name=".assist.JarvisVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          Stub recognizer. android:recognitionService in
          jarvis_voice_interaction_service.xml must point at a resolvable
          component on several OS versions or the voice-interaction entry is
          rejected. It reports ERROR_CLIENT immediately; real STT is the
          server's pipeline.
        -->
        <service
            android:name=".assist.JarvisRecognitionService"
            android:exported="true"
            android:label="@string/recognition_service_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- ================================================================
             Implemented by the AUTOMATION module (ai.jarvis.app.automation.**).
             Declared here so that module never has to touch this file.
             ================================================================ -->

        <!--
          The device command channel: authenticated WebSocket to jarvis-core,
          device registration, command dispatch through the local policy table.
        -->
        <!--
          Always-on "Hey Jarvis". Holds the microphone open and detects the name
          on the phone (assist/OnDeviceWakeWord.kt); audio leaves the phone only
          after it is said. Until the on-device models have downloaded, the mic
          streams to the user's own server, which detects instead; nothing is
          stored at either end. Only ever runs when `wakeWordEnabled` is set, and its
          notification is not dismissible while it does, because an open mic
          with no visible sign of it is not something to ship.
        -->
        <!-- T-0616: screens a call from a number that is not a contact, by the owner's rule (ring,
             silence, reject). Bound only by the system and only once the owner grants the
             call-screening role; with the default rule it does nothing. -->
        <service
            android:name="ai.jarvis.app.calls.JarvisCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name="ai.jarvis.app.assist.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          "Hey Jarvis" as a quick-settings tile, so turning listening back on
          after a reboot is a swipe rather than a trip through Settings.
          exported=true and the BIND permission are what the system requires to
          bind a tile; the permission is one only the system holds.
        -->
        <service
            android:name="ai.jarvis.app.assist.WakeTileService"
            android:exported="true"
            android:icon="@drawable/ic_jarvis_status"
            android:label="@string/tile_wake_word"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
          The quarter-hourly "is it still listening?" alarm. START_STICKY alone
          is not enough on 12+, because the restart the system performs after a
          kill is itself a background start of a microphone service and may be
          refused. Not exported, and its PendingIntent is explicit and
          immutable, so nothing outside this app can fire it.
        -->
        <receiver
            android:name="ai.jarvis.app.assist.WakeHeartbeatReceiver"
            android:exported="false" />

        <!--
          The home-screen orb (T-0590). Exported because the launcher is another app and
          broadcasts APPWIDGET_UPDATE to it; it answers only that, draws, and its one tap is an
          explicit immutable PendingIntent to ListenTrampolineActivity.
        -->
        <receiver
            android:name="ai.jarvis.app.assist.OrbWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_orb_info" />
        </receiver>

        <service
            android:name="ai.jarvis.app.automation.JarvisAutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent authenticated WebSocket to the user's self-hosted Jarvis server, so the device can receive and locally authorise commands." />
        </service>

        <!--
          UI automation. Off until the user enables it in Settings >
          Accessibility. Screen content it reads is untrusted data; every tap or
          text entry it performs is Tier 3.
        -->
        <service
            android:name="ai.jarvis.app.automation.accessibility.JarvisAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/jarvis_accessibility_service" />
        </service>

        <!--
          Notification listener — a TRIGGER source only. Notification text is
          untrusted data: it may start a rule evaluation, but it can never route
          into the action dispatcher without a fresh human approval.
        -->
        <service
            android:name="ai.jarvis.app.automation.notify.JarvisNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Restarts the command channel, the wake listener and any pending
          reminders after a reboot. Protected broadcast.

          `directBootAware="false"` is deliberate, and BOOT_COMPLETED is the
          right broadcast for it: on a file-based-encryption device that is
          delivered AFTER the first unlock, which is when this receiver can
          actually read the token, the policy store and the user's preferences.
          The before-first-unlock broadcast is not filtered for, because at that
          point `PolicyStore` is unreadable and "panic is not set" would be
          indistinguishable from "I cannot tell whether panic is set". See
          BootReceiver's KDoc.
        -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          The in-app updater's other half. PackageInstaller.commit() does not
          show anything: it sends STATUS_PENDING_USER_ACTION to an IntentSender,
          carrying the system's "install this update?" activity, and SOMEBODY
          HAS TO START IT. Nothing did, so the updater downloaded an APK,
          committed a session, and installed nothing on any device.

          In the manifest rather than registered in code, because the install
          can outlive the Activity that started it — and not exported, so no
          other app can fabricate an install verdict. The broadcast that reaches
          it is addressed by component, so the implicit-broadcast restrictions
          never apply.
        -->
        <!-- "That was me" from the tray (VoiceClaim). Not exported: only this app's own
             PendingIntent reaches it, so no other app can claim a voice as the owner's. -->
        <receiver
            android:name=".assist.VoiceClaimReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.jarvis.app.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Trigger sources: power, connectivity, headset, airplane mode.
             All protected system broadcasts. -->
        <!--
          Reminders. NOT exported: the only thing that ever sends this action is
          an AlarmManager PendingIntent this app created. Exporting it would let
          any app on the phone fabricate a reminder notification in Jarvis's
          name, which is a phishing surface for the price of a broadcast.
        -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.jarvis.app.automation.REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="ai.jarvis.app.automation.triggers.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.media.AUDIO_BECOMING_NOISY" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Fired only by this app's own AlarmManager PendingIntents. -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.AlarmReceiver"
            android:exported="false" />

        <!-- A routine's time of day (ai.jarvis.app.routines.RoutineWatcher); own alarms only. -->
        <receiver
            android:name="ai.jarvis.app.routines.RoutineAlarmReceiver"
            android:exported="false" />

        <!--
          The automation module's two screens. MainActivity and SettingsActivity
          launch them by name (see ai.jarvis.app.ui.JarvisScreens) rather than by
          class reference, so this module never imports from that one. Provide
          classes with exactly these names and the links light up.
        -->
        <activity
            android:name="ai.jarvis.app.automation.ui.AutomationsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name="ai.jarvis.app.automation.ui.AuditLogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Per-action ASK / ALWAYS / NEVER. The only thing in the app that writes
          PolicyStore.setPolicy, which had been sitting there with no caller
          since it was written — so "may Jarvis do this without asking?" was a
          question the user could not answer.
        -->
        <activity
            android:name="ai.jarvis.app.automation.ui.ActionPolicyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Jarvis on the car display. See ai.jarvis.app.car.templated.JarvisCarAppService.

          `exported` must be true — the car host is another process and binds
          this by intent — which is exactly why the service validates its
          caller's signature rather than trusting the bind. The category is
          NAVIGATION (T-0613): Jarvis routes the drive and draws it, the
          hologram map on the template's surface, which only a navigation app
          is given. One category, so the app sits in one launcher section.
        -->
        <service
            android:name=".car.templated.JarvisCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!--
          The minimum car API level this app needs (CarNavScreen.MIN_CAR_API).
          NavigationTemplate and the map surface are level 1; taps on the
          surface are level 5 and optional, because the action strip mirrors
          every drawn button. Asking for more would exclude older head units.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- ============ The car (ADR-0047, ai.jarvis.app.car) ============ -->
        <service
            android:name=".car.service.CarLinkService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice|location" />
        <activity
            android:name=".car.setup.CarSetupActivity"
            android:exported="false"
            android:label="Set up your car"
            android:theme="@style/Theme.Jarvis" />
        <activity
            android:name=".car.video.ProjectionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.JarvisCarInvisible" />
        <activity
            android:name=".car.dash.tiles.WidgetSetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.JarvisCarInvisible" />
        <receiver
            android:name=".car.link.CarPresenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
          Two more grants beside Jarvis's own listener and accessibility
          service, on purpose: the car's touch injector reads no window
          content (canRetrieveWindowContent="false", Headway's promise), which
          Jarvis's UI automation must. One service cannot be both.
        -->
        <service
            android:name=".car.dash.tiles.HeadwayNotificationListener"
            android:exported="true"
            android:label="@string/car_notifications_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".car.input.HeadwayAccessibilityService"
            android:exported="false"
            android:label="@string/car_touch_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/car_touch_service" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.carlogs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/car_log_paths" />
        </provider>
        <provider
            android:name=".car.carapp.CarConnectionProvider"
            android:authorities="androidx.car.app.connection"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
