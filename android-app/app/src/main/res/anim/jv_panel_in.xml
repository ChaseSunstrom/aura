<?xml version="1.0" encoding="utf-8"?>
<!-- A native screen slides in from the end, as the console's side panel does (T-0725).
     Duration and curve are the design system's (generated @integer, @interpolator). -->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromXDelta="100%"
    android:toXDelta="0"
    android:duration="@integer/jv_dur_appear"
    android:interpolator="@interpolator/jv_ease_appear" />
