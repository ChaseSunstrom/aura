<?xml version="1.0" encoding="utf-8"?>
<!-- The screen underneath stays put while one slides over it: without an animation of the
     same length the system's default would move it too. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="1"
    android:toAlpha="1"
    android:duration="@integer/jv_dur_appear" />
