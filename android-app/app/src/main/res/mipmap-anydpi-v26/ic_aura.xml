<?xml version="1.0" encoding="utf-8"?>
<!--
  AURA adaptive launcher icon (API 26+, i.e. always at minSdk 29), the default
  persona's (T-0869). The background and foreground are the pack's own art,
  themes/aura/assets/icons/aura-adaptive-*-432.png, copied byte for byte into
  drawable-xxxhdpi (432 px is 108 dp at xxxhdpi); the monochrome layer is the pack's
  glyph as an alpha-only vector for Android 13+ themed icons.
  android-app/tools/aura_theme_test.py keeps the copies equal to the pack.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_aura_background" />
    <foreground android:drawable="@drawable/ic_aura_foreground" />
    <monochrome android:drawable="@drawable/ic_aura_monochrome" />
</adaptive-icon>
