# deploy/.env — the ONE hand-created file on the JARVIS host (copy to /opt/jarvis/.env).
# Never commit the filled-in copy. Everything else reaches the host as images + this compose file.
# Names were JARVIS_* before T-0959; a .env that still says JARVIS_X keeps working (each is read
# as AURA_X unless AURA_X is set), so rename keys when convenient, not all at once.

# ---- image ------------------------------------------------------------------
AURA_REGISTRY=registry.home.example/acme/jarvis
AURA_TAG=main                       # the pipeline writes the short SHA here on deploy

# ---- network ----------------------------------------------------------------
# Ports are published on this address ONLY: the host's LAN address, reached from outside over
# WireGuard into the LAN. The name is from before the 2026-10-27 move off Tailscale and stays
# for compatibility. Anything else on the host gets "connection refused"; a wrong address
# means no port binds at all (boot-recover.log says "not on any interface").
TAILSCALE_IP=192.168.1.10
# Browser origins allowed to call the adapter/API directly (the console's own origin).
AURA_CORS_ORIGINS=https://jarvis.home.example,http://jarvis.home.example:8199   # the console's origins: HTTPS 443 (Caddy) and the raw port
# The URL the phone's pairing QR carries (how the phone reaches the adapter).
# The console's HTTPS relay: https://<console host>/hermes (the phone refuses
# cleartext to a bare LAN address, and the proxy in front of the console does not carry :8643).
AURA_PUBLIC_URL=https://jarvis.home.example/hermes   # the console's relay to the adapter, for the apps' pairing QR
TZ=UTC   # your timezone, as an IANA name (Europe/Berlin): times are spoken and scheduled in it

# ---- secrets (generate: openssl rand -hex 32) ---------------------------------
# Every `change-me`, `dev…` and `test…` value below is named in the container's log on
# every start until it is replaced (deploy/entrypoint.sh). On 2026-09-07 three of this
# host's four secrets were still the repository's dev placeholders.
AURA_API_KEY=change-me-apps-bearer-key
HERMES_API_KEY=change-me-hermes-api-server-key
HERMES_SERVE_TOKEN=change-me-hermes-dashboard-session-token

# ---- the brain --------------------------------------------------------------
# The house's own model server (jarvis-models, this compose file); llama-swap answers both.
LLM_URL=http://jarvis-models:8000/v1
LLM_MODEL=qwen3.8-27b
LLM_CONTEXT_LENGTH=262144
LLAMA_SWAP_URL=http://jarvis-models:8000
# Where jarvis-models keeps weights (Hugging Face cache) and one llama-swap file per model.
# Unset, ./models beside the compose file; production keeps them on the big disk.
# AURA_MODELS_DIR=/srv/jarvis-models
# The key the adapter presents to the model manager (the console's Models panel); generate one:
#   openssl rand -hex 32
MODELS_API_KEY=change-me-models-manager-key
# The inference key: llama-swap in jarvis-models answers only `Authorization: Bearer <this>`
# (Hermes, the adapter and the house gateway send it; CI's smoke stack takes it from the
# LLM_API_KEY CI variable). A different secret from the manager's, because Hermes holds this
# one and its tools must not hold the manager's. Unset, llama-swap stays open and warns.
LLM_API_KEY=change-me-llm-inference-key
GOALS_MAX_TURNS=20
# How long JARVIS thinks before answering: none|minimal|low|medium|high|xhigh|max|ultra.
# Leave at medium; unbounded thinking on qwen3.8-27b outlasts every task budget.
LLM_REASONING_EFFORT=medium
# The same for a spoken question (car, phone, console mic). Changed by voice through
# settings_set; the adapter reads it on every spoken turn. Keep it equal to the above or
# `none`: any other level changes the top of the model's prompt, and a spoken turn after a
# typed one then re-reads the whole conversation (T-0814).
VOICE_REASONING_EFFORT=medium
# How JARVIS says names a voice gets wrong, written=spoken pairs ("Siobhan=shi-vawn; Nguyen=win"),
# and when it speaks softer and a little slower (HH:MM-HH:MM, house time, may wrap midnight; empty
# for never). Both settable by voice; the adapter reads them on every line it speaks (T-0587).
AURA_PRONUNCIATIONS=
AURA_QUIET_HOURS=23:00-07:00

# The one privacy switch (T-0837): true and the house makes no call out on its own (the sky's
# downloads, a scheduled weather forecast); what you ask for still works. Settable by voice
# (restart needed). jarvis-core reads the same name from ITS .env (aura-core/.env), so set both.
AURA_QUIET_HOUSE=false

# ---- model routing (D21) ----------------------------------------------------
# Empty = LLM_MODEL answers, which is the measured position: llama-swap serves one
# 24 GB-class model at a time here, so every route between models is a cold start.
# Fill one of these in only when the benchmark's swap column says the swap pays for
# itself (bench/results/*.md, the per-category "swaps" column).
# image/screenshot analysis; empty = LLM_MODEL
ROUTING_VISION_MODEL=
# compression, titles, goal judge, curator
ROUTING_AUXILIARY_MODEL=
# delegated subagents; empty = inherit the parent
ROUTING_DELEGATION_MODEL=
# Unquoted in the config template: leave a number here, never blank.
ROUTING_DELEGATION_MAX_CONCURRENT=5      # largest subagent batch; a bigger one is refused, not queued
ROUTING_DELEGATION_MAX_DEPTH=2           # 1 = a subagent cannot delegate; 2 = it can run children of its own

# ---- voice ------------------------------------------------------------------
WHISPER_MODEL=small                   # baked into the image (HF_HUB_OFFLINE=1); another size = rebuild with --build-arg WHISPER_MODEL=
PIPER_VOICE=en_GB-alan-medium         # baked into the image; another name downloads on first use
# The house voice: CosyVoice 3 (jarvis-cosyvoice, on by default; docker-compose.gpu.yml puts it on
# the card when the host has one). `piper` puts the house back on Piper.
TTS_PROVIDER=openai
TTS_OPENAI_BASE_URL=http://jarvis-cosyvoice:8890/v1
TTS_VOICE=af_heart                    # Hermes's own voice: the default theme's (AURA's Kokoro stock voice)
# Where the weights live on the host: outside the deploy directory, which the pipeline rsyncs with
# --delete. No reference clips are mounted (T-0901): Kokoro speaks every voice.
COSYVOICE_MODELS_DIR=/opt/jarvis-host/voice/models
COSYVOICE_TAG=latest
AURA_TTS_ENGINE=cosyvoice           # cosyvoice = each persona in its own voice (default) | wyoming = Piper, one voice

# ---- the house (jarvis-core as the house service, HA-shaped REST) ------------
HASS_URL=http://host.docker.internal:8080
HASS_TOKEN=change-me-jarvis-core-token
# The secret the emergency plugin proves a new contact list under (T-1213); the house keeps a list only
# with that proof. It must equal AURA_EMERGENCY_SECRET in aura-core/.env (scripts/install.sh sets both).
# Empty: nothing is pushed and the house refuses every change. openssl rand -hex 32
AURA_EMERGENCY_SECRET=

# ---- homelab plugins --------------------------------------------------------
SEARXNG_URL=http://searxng:8080          # the stack's own SearXNG (the searxng CT has no egress)
# openssl rand -hex 32
SEARXNG_SECRET=
EXTRACT_URL=http://jarvis-extract:8896   # the stack's own extraction service; no cloud fallback exists
EXTRACT_TIMEOUT=45
EXTRACT_ENABLED=true
# place_search (the car's "nearest coffee", an address): the house's place index
# (scripts/map-region.sh), then its Photon. PHOTON_PUBLIC=true adds the public Photon and
# Nominatim, and an OVERPASS_URL a public Overpass; each then hears a rounded point.
PHOTON_URL=http://127.0.0.1:2322
PHOTON_PUBLIC=false
OVERPASS_URL=
# car_navigate has the house download the map region a route ends in when no offline map
# covers it (the maps-worker fetches it from Geofabrik, which hears the region's name only).
# false: a region is downloaded only when asked for.
AURA_MAPS_AUTO_FETCH=true
# The activity view: the browser and the desktop as a live tile on the HUD, redacted at the
# source. false stops every frame in the container; the tile then never opens.
ACTIVITY_ENABLED=true
# The house's DNS zone: every name under it is a homelab service the tools may reach and never
# the public internet. Empty: the zone GitLab is in (gitlab.home.example -> home.example).
HOUSE_DOMAIN=
GRAFANA_URL=https://grafana.home.example
GRAFANA_TOKEN=
GRAFANA_INFLUX_DS=
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=proxmox            # the bucket telegraf writes nvidia_smi into on the monitor CT
# The stack's own n8n (T-0630, docs/runbooks/n8n.md). Its secrets are NOT here: deploy/n8n-env.sh
# generates n8n.env beside this file, which is read by the n8n services directly. N8N_API_KEY
# is the one value that comes from you: create n8n's owner account, then Settings -> n8n API.
N8N_URL=http://n8n:5678
N8N_API_KEY=
#N8N_PORT=5678                  # the published port (bind address and loopback)
#N8N_ENABLED_MODULES=instance-ai
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false
# ComfyUI is not running (deleted with the old LXC 2026-10-09); it moves onto JARVIS under T-0285.
COMFYUI_URL=
COMFYUI_VERIFY_SSL=false
COMFYUI_CHECKPOINT=
COMFYUI_WORKFLOW=qwen-image      # the house's ComfyUI carries Qwen-Image (UNET+CLIP+VAE), not an SD checkpoint
GITLAB_API_URL=https://gitlab.home.example/api/v4
GITLAB_TOKEN=
GITLAB_PROJECT_ID=3               # the jarvis project, so a self-extension merge request can be looked up
MCP_GITLAB_ENABLED=false
# Self-extension (D24): the checkout JARVIS scaffolds a new plugin into and pushes a
# branch from. It needs a git work tree with a remote it can reach; the merge request is
# opened by GitLab push options, so no API token is involved and nothing is ever merged.
SELFEXT_REPO_PATH=/opt/data/work/jarvis
SELFEXT_TARGET_BRANCH=main
JELLYFIN_URL=
# Jellyfin Dashboard -> API Keys; a read-scope key is enough to browse
JELLYFIN_TOKEN=
# Plex, read-only (libraries, recently added, now playing, search). https, or plain http
# only to a private address such as http://192.168.1.20:32400; the token goes in a header.
PLEX_URL=
PLEX_TOKEN=

# ---- mail (IMAP in, SMTP out) -----------------------------------------------
# One mailbox, not an admin account: JARVIS reads and sends as this identity only.
MAIL_IMAP_HOST=
MAIL_SMTP_HOST=
MAIL_USERNAME=
# an app password where the provider offers one
MAIL_PASSWORD=
# empty falls back to MAIL_USERNAME
MAIL_FROM=

# ---- calendar / contacts / files (one DAV server) ---------------------------
# e.g. https://cloud.lan/remote.php/dav
DAV_URL=
DAV_USERNAME=
DAV_PASSWORD=

# ---- messaging (D20) ---------------------------------------------------------
# A bot token alone does NOT switch a platform on: Hermes would enable it the moment
# it saw the token, so the *_ENABLED flags are written into config.yaml explicitly.
# *_ALLOWED_USERS is the allowlist Hermes' own gateway authorization reads. Leave it
# empty and nobody is authorized — the gateway default-denies when no allowlist is
# configured, which is the behaviour we want if a token ever leaks.
TELEGRAM_ENABLED=false
# from @BotFather
TELEGRAM_BOT_TOKEN=
# comma-separated numeric user ids; empty = nobody
TELEGRAM_ALLOWED_USERS=
# chat id proactive messages are delivered to
TELEGRAM_HOME_CHANNEL=
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# comma-separated user ids; empty = nobody
DISCORD_ALLOWED_USERS=
DISCORD_HOME_CHANNEL=
GATEWAY_UNAUTHORIZED_DM_BEHAVIOR=pair   # pair = offer a code the owner approves; ignore = drop silently
# Never set TELEGRAM_ALLOW_ALL_USERS / DISCORD_ALLOW_ALL_USERS / GATEWAY_ALLOW_ALL_USERS
# here: each one turns the allowlist off for that platform (or for all of them).

# ---- inbound webhooks (n8n, CI, sensors -> a JARVIS turn) -------------------
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8650
# openssl rand -hex 32; every route must sign its body with it
WEBHOOK_SECRET=

# ---- web console (jarvis-web) -------------------------------------------------
AURA_URL=http://host.docker.internal:8080   # jarvis-core, for the house pages
AURA_TOKEN=change-me-jarvis-core-token
AURA_CONSOLE_PASSWORD=change-me
# or an scrypt$… line instead of the plaintext
AURA_CONSOLE_PASSWORD_HASH=
# override for where a browser-chosen password is stored (default /app/.storage)
AURA_CONSOLE_PASSWORD_FILE=
# the console's https address (https://jarvis.home.example), which passkeys are bound to;
# empty, or plain http or a bare address: no passkeys, and the password still works
AURA_CONSOLE_ORIGIN=
# minutes a browser may sit unused before the console asks again (default a week)
AURA_CONSOLE_IDLE_MINUTES=
AURA_PAIRING_SECRET=

# ---- backups -----------------------------------------------------------------
BACKUP_DIR=/opt/jarvis/backups        # host path the nightly backup (hermes-home-*.tar.gz.age) lands in
BACKUP_KEEP=14
# Backups are encrypted with age. Make a key pair once, off the host or in a place you keep a copy of:
#   age-keygen -o backup-age.key        (prints the public key: age1…)
# BACKUP_AGE_RECIPIENT is the public key; the nightly refuses to write without it.
BACKUP_AGE_RECIPIENT=
# Host path of the private key file (mounted read-only; only the Sunday restore drill reads it).
# Lose it and every backup is unreadable: keep a copy somewhere else.
BACKUP_AGE_IDENTITY=
# A second location: a host path on another disk or a NAS mount. Each backup is copied there and
# pruned to BACKUP_KEEP; the drill fails while it is unset.
BACKUP_MIRROR_DIR=

# Where every shipped cron job delivers. Empty means the house companion; `telegram`,
# `discord` or `platform:chat_id` send it to a messaging platform instead.
PROACTIVE_DELIVER=

# ---- the GPU watchdog and quiet hours ---------------------------------------
# The watchdog routine is seeded only where GRAFANA_URL or INFLUX_URL is set: it reads the
# homelab's telemetry, not this machine's card. With neither, these four are unused.
GPU_TEMP_ALERT_C=80            # °C at which the watchdog raises an alert
GPU_TEMP_CLEAR_C=78            # and the temperature it clears under; the gap stops a card on the limit flapping
GPU_VRAM_ALERT_PCT=95          # VRAM in use (%) that raises an alert
GPU_VRAM_CLEAR_PCT=90          # and the percentage it clears under
PROACTIVE_QUIET_HOURS_FROM=22  # hour digests and recovery notices hold until quiet hours end
PROACTIVE_QUIET_HOURS_TO=7     # equal to FROM means no quiet hours; a threshold alert fires regardless
