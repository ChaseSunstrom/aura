{
  "_comment": "The HUD panel surface, shared by hermes/plugins/aura-hud (emitter) and the apps (renderers). docs/hermes-hud-protocol.md 'Panels' is the prose; this is what the suites assert. `kinds` is append-only: the Android mirror compares it element-wise. The last three are the media kinds (a published artifact by url + mime, with its provenance); `download_mimes` is the adapter's EXECUTABLE_MIME, the types safe_disposition serves as an attachment, so a document body offers a download rather than pretending to embed one.",
  "events": ["hud.panel.show", "hud.panel.update", "hud.panel.dismiss"],
  "origins": ["agent", "user", "system"],
  "kinds": ["text", "table", "image", "chart", "camera", "code", "terminal", "web", "device", "telemetry", "goal", "approval", "clarify", "notice", "video", "audio", "document"],
  "media_fields": ["url", "mime"],
  "download_mimes": ["text/html", "application/xhtml+xml", "image/svg+xml", "application/xml", "text/xml", "application/javascript", "text/javascript"],
  "required_show_fields": ["id", "kind", "title", "payload", "origin", "created_at", "rev"],
  "dismiss_all_id": "*",
  "command": {"name": "hud", "list": "@<sid> list", "dismiss": "@<sid> dismiss <id|*>"},
  "motion": {"summon_ms": 200, "dismiss_ms": 160, "reorder_ms": 240, "reduced_motion_ms": 80},
  "examples": {
    "text": {"markdown": "The kitchen is **22 °C**."},
    "table": {"columns": ["GPU", "VRAM", "Temp"], "rows": [["0", "93.6 %", "50 °C"], ["1", "93.6 %", "50 °C"]]},
    "image": {"url": "/hermes/api/files/out/jarvis_00001_.png", "alt": "a red fox"},
    "chart": {"series": [{"name": "load1", "points": [[0, 0.4], [60, 0.9]]}], "unit": ""},
    "camera": {"camera": "Garden", "url": "/api/camera/garden/still", "taken_at": "2026-09-03T00:41:12Z"},
    "code": {"language": "python", "text": "print('hi')", "path": "hi.py"},
    "terminal": {"command": "uptime", "output": " 00:41 up 4 days", "exit_code": 0},
    "web": {"url": "https://n8n.example.ts.net", "title": "n8n"},
    "device": {"entity_id": "light.kitchen", "name": "Kitchen", "state": "on", "attributes": {"brightness": 200}},
    "telemetry": {"gpus": [{"gpu": "0", "utilization": 0, "vram_pct": 93.6, "temperature": 50, "power": 22}]},
    "notice": {"level": "info", "text": "Model warmed up"},
