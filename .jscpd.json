{
	"threshold": 1,
	"minLines": 10,
	"minTokens": 60,
	"reporters": ["console", "json"],
	"absolute": true,
	"gitignore": false,
	"ignore": [
		"**/node_modules/**",
		"**/.venv/**",
		"**/__pycache__/**",
		"**/.svelte-kit/**",
		"**/build/**",
		"**/dist/**",
		"**/dist-app/**",
		"**/test-results/**",
		"**/bench/results/**",
		"**/*.min.*",
		"**/styles/tokens.css",
		"**/renderer/tokens.css",
		"**/lib/tokens.ts",
		"**/main/tokens.ts",
		"**/theme/JarvisTokens.kt",
		"**/theme/JarvisTheme.kt",
		"**/ui/SiriPalette.kt",
		"**/design/generated/**",
		"**/res/drawable/ic_jarvis_*.xml",
		"**/res/drawable/ic_persona_*_foreground.xml",
		"**/aura_adapter/speech_text.py",
		"**/helpers/ssrf_parse.py",
		"**/fixtures/**",
		"**/__fixtures__/**",
		"**/screenshots/**",
		"**/*.snap"
	]
}
